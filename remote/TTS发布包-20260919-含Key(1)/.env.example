# TTS 模块环境变量模板（**不含 Key**，仅备用）
#
# 用法：复制成 .env 再填真值，注意要放在 tts.py **同级**：
#       cp .env.example .env && chmod 600 .env
#
# ★ .env 已被 tts/.gitignore 忽略；不要提交进仓库。

# --- 必填 ---
# 小米 MiMo 的 API Key（注意鉴权头是 api-key，不是 Authorization，代码里已处理）
MIMO_API_KEY=

# --- 树莓派上要填 ---
# 用 aplay -l 查到 USB 音箱的 card 名，再用 plughw 写在这里。
#   OK   plughw:CARD=Device,DEV=0   会自动重采样，云端音频是 24000Hz，必须用它
#   NO   hw:CARD=Device,DEV=0       只接受设备原生采样率，24000Hz 会直接报错
# 用 CARD 名而不是编号：USB 插拔 / 重启会改变 card 编号，名字是稳定的。
# 留空 = 按顺序自动探测（一般能落到 USB 声卡）。
TTS_ALSA_DEVICE=

# 缓存目录必须写**绝对路径**：systemd 的工作目录不是部署目录，
# 写相对路径会导致重启后重新合成、演示前预热全部白做。
TTS_CACHE_DIR=/home/pi/robot/tts/.tts_cache

# --- 可选（不填就用默认值）---
# TTS_VOICE=REDACTED-ROTATE-ME
# TTS_VOLUME=100
# TTS_TIMEOUT=5
# TTS_DEADLINE=15
# TTS_PLAYER=aplay          # 留空则自动探测；Pi 上会自动落到 aplay
