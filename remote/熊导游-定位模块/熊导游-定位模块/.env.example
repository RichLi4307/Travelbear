# 复制成 .env 并填入真实值。.env 已被 .gitignore 排除，不会提交。
#
# 用法（Linux / 树莓派）：
#     set -a; source .env; set +a
#     python -m pytest -q
#
# 用法（Windows PowerShell）：
#     Get-Content .env | ForEach-Object {
#         if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#             [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim())
#         }
#     }
#
# 用法（用 systemd 跑服务）：写进 /etc/default/bear-guide，或 EnvironmentFile=

# ── 高德 Web 服务 Key ────────────────────────────────────────────────
# 申请：https://console.amap.com/dev/key/app
# 类型必须选「Web服务」！选成 Android/iOS 会报 10009 USERKEY_PLAT_NOMATCH。
# 不填也能跑 —— 本地景区围栏照常工作，只是去陌生地方时认不出地名。
AMAP_WEB_KEY=your_key_here

# ── GNSS 串口 ───────────────────────────────────────────────────────
# 树莓派上走 USB 串口（不要用 GPIO UART，会和板载蓝牙抢资源）
# GNSS_PORT=/dev/ttyUSB0
# Windows 笔记本上按设备管理器里的实际端口填，比如 COM5
# GNSS_PORT=COM5
# GNSS_BAUD=9600

# ── 覆盖默认配置文件位置（一般不用改）────────────────────────────────
# SCENIC_AREAS_YAML=location/scenic_areas.yaml
# BEACONS_YAML=location/beacons.yaml
# POI_CACHE=data/poi_cache.sqlite
